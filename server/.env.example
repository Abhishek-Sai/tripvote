PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection string for Supabase's transaction pooler (port 6543).
# Supabase dashboard > Connect > Direct > Transaction pooler. Copy it into
# server/.env and replace [YOUR-PASSWORD]. Never commit the real value.
# Leave off any ?sslmode=... suffix: the server configures TLS itself.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# TLS: the server verifies the database certificate using
# server/certs/supabase-ca.crt (committed). Only set this to use another file.
# DATABASE_CA_CERT_PATH=

# Supabase dashboard > Project Settings > API. Use the development project.
# Kept for Supabase Realtime (itinerary updates, T6).
SUPABASE_URL=https://[PROJECT-REF].supabase.co
# Server-only secret. Never commit it or use it in client code.
SUPABASE_SERVICE_ROLE_KEY=
